{
  "name": "SiteImage",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique identifier for this image (e.g. sea_freight_1)"
    },
    "url": {
      "type": "string",
      "description": "The uploaded file URL"
    },
    "alt": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "url"
  ]
}