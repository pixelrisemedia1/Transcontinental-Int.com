{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "read_time": {
      "type": "string"
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "author": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "content"
  ]
}